{
    "name": "uiarts/backpack-repeatable",
    "description": "Nested repeatable fields with lazy loading for Laravel Backpack 6",
    "license": "MIT",
    "authors": [
        {
            "name": "UiArts",
            "email": "hello@ui-arts.com",
            "homepage": "https://ui-arts.com"
        }
    ],
    "keywords": [
        "Laravel",
        "Backpack",
        "Backpack for Laravel",
        "Backpack Addon",
        "BackpackRepeatable"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "backpack/crud": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Uiarts\\BackpackRepeatable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Uiarts\\BackpackRepeatable\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Uiarts\\BackpackRepeatable\\AddonServiceProvider"
            ]
        }
    }
}
